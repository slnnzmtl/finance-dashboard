# Host Caddy owns :80/:443 on 13.140.158.49.
# Keep this block in /etc/caddy/Caddyfile (the caddy user cannot read $HOME).
#   sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# DNS: A record finance.slnnzmtl.xyz → 13.140.158.49

finance.slnnzmtl.xyz {
	bind 13.140.158.49

	encode gzip

	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy 127.0.0.1:3010
}
